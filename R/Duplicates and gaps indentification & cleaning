#Some script for identifying and removing duplicates
#Some script for making time series complete and identifying gaps

setwd("X:/Fynbos working data")
dat<-read.csv("CR1000_Dwarsberg_Jonkershoek_Table1.csv",skip=0) ##edit your .csv file to only include one row of column headers before reading it in

#Identify and remove duplicate rows
duplicated(dat) ##Identify
dat[duplicated(dat), ] ##View duplicates
dat[!duplicated(dat), ] ##View dataframe without duplicates
duplicateless<- dat[!duplicated(dat), ] ##Create a dataframe of the "duplicateless" data
write.csv(duplicateless,"X:/Fynbos working data/data_without_duplicates.csv", sep="\t", col.names=T,quote=F, row.names=T, na = "NA")

x<-as.data.frame(dat[duplicated(dat), ] ) #create a dataframe of the duplicates if needed

#Find gaps and fill them with NA
# For argument's sake your time series starts at 2015/06/18 10:00 and ends at 2023/06/26 07:00
ts <- seq.POSIXt(as.POSIXct("2015/06/18 10:00",'%Y/%m/%d %H:%M', t ="Africa/Johannesburg"), as.POSIXct("2023/06/26 07:00",'%Y/%m/%d %H:%M', tz="Africa/Johannesburg"), by="hour")  ##Insert the start and end TIMESTAMPS of your raw data. This creates a TIMESTAMP column without any missing hours
ts <- format.POSIXct(ts,'%Y/%m/%d %H:%M', tz="Africa/Johannesburg")  ##Ensure the TIMESTAMP format in the ts is the same as in your raw data
df <- data.frame(timestamp=ts) ##Change your ts into a dataframe before you can join it to your raw data
colnames(df) <- c("TIMESTAMP") ##Change your timeseries dataframe's column heading to TIMESTAMP to match the raw data column heading
library(dplyr)
data_with_missing_times <- left_join(df,duplicateless, by = "TIMESTAMP") ##Join the the time series and your raw data by the TIMESTAMP column
write.csv(data_with_missing_times, "X:/Fynbos working data/fixed.csv", sep="\t", col.names=T,quote=F, row.names=T, na = "NA")

na_rows <- data_with_missing_times[is.na(data_with_missing_times$RECORD), ] ##Create a dataframe with just rows that have missing data. Note, the RECORD column is used for this
